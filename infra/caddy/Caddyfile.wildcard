# =============================================================================
# BMStore edge — WILDCARD variant: one *.<ROOT_DOMAIN> certificate via DNS-01.
# Use when your DNS provider has an API and you set CADDY_DNS_PLUGIN + DNS_API_TOKEN
# (rebuild caddy afterwards: ./deploy/compose.sh build caddy && ./deploy/compose.sh up -d caddy).
# Custom tenant domains still use on-demand TLS gated by tls-ask.
# Provider modules that need more than one token (e.g. namecheap) require editing the "dns" line.
# NOT exercised in this repo's sandbox — see docs/runbooks/DEPLOY_REPORT.md.
# =============================================================================
{
	email {$ACME_EMAIL}
	on_demand_tls {
		ask http://tls-ask:8080/ask
	}
	order rate_limit after header
	servers {
		protocols h1 h2 h3
	}
}

(access_log) {
	log {
		output stdout
		format json
	}
}

(security_headers) {
	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "SAMEORIGIN"
		Referrer-Policy "strict-origin-when-cross-origin"
		Permissions-Policy "camera=(), microphone=(), geolocation=(), usb=(), interest-cohort=()"
		Cross-Origin-Opener-Policy "same-origin-allow-popups"
		-Server
		-X-Powered-By
		defer
	}
}

(limits) {
	request_body {
		max_size 25MB
	}
	rate_limit {
		zone auth_per_ip {
			match {
				path /api/auth/* /auth/*
			}
			key {client_ip}
			events 20
			window 1m
		}
		zone per_ip {
			key {client_ip}
			events 600
			window 1m
		}
	}
}

(platform_api) {
	uri strip_prefix /api
	reverse_proxy api:3000 {
		header_up Host api.{$ROOT_DOMAIN}
		header_up X-Forwarded-Host api.{$ROOT_DOMAIN}
	}
}

# One site, one wildcard certificate, host matchers inside.
*.{$ROOT_DOMAIN}, {$ROOT_DOMAIN} {
	tls {
		dns {$CADDY_DNS_PLUGIN} {env.DNS_API_TOKEN}
	}
	import access_log
	import security_headers
	import limits
	encode zstd gzip

	@api host api.{$ROOT_DOMAIN}
	handle @api {
		reverse_proxy api:3000
	}

	@admin host admin.{$ROOT_DOMAIN}
	handle @admin {
		handle /api/* {
			import platform_api
		}
		handle {
			reverse_proxy {$ADMIN_UPSTREAM}
		}
	}

	@console host console.{$ROOT_DOMAIN}
	handle @console {
		handle /api/* {
			import platform_api
		}
		handle {
			reverse_proxy {$CONSOLE_UPSTREAM}
		}
	}

	@root host {$ROOT_DOMAIN} www.{$ROOT_DOMAIN}
	handle @root {
		redir https://console.{$ROOT_DOMAIN}{uri} permanent
	}

	@media host media.{$ROOT_DOMAIN}
	handle @media {
		@write not method GET HEAD OPTIONS
		respond @write 405
		header Cache-Control "public, max-age=31536000, immutable"
		reverse_proxy minio:9000
	}

	@minio host minio.{$ROOT_DOMAIN}
	handle @minio {
		reverse_proxy minio:9001
	}

	# Any other <slug>.<ROOT_DOMAIN> is a tenant store (unknown slugs get the API's 404).
	handle /api/* {
		uri strip_prefix /api
		reverse_proxy api:3000
	}
	handle {
		reverse_proxy {$STOREFRONT_UPSTREAM}
	}
}

# Customer-owned domains: on-demand certificates approved by tls-ask.
https:// {
	tls {
		on_demand
	}
	import access_log
	import security_headers
	import limits
	encode zstd gzip
	handle /api/* {
		uri strip_prefix /api
		reverse_proxy api:3000
	}
	handle {
		reverse_proxy {$STOREFRONT_UPSTREAM}
	}
}

http:// {
	redir https://{host}{uri} permanent
}
