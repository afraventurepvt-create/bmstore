# --- Runtime ---
NODE_ENV=development
PORT=3000
# Dev: storename.localhost  |  Prod: storename.bmstore.in
ROOT_DOMAIN=localhost
# Set to 1 only when behind a trusted reverse proxy (so req.hostname uses X-Forwarded-Host)
TRUST_PROXY=0

# --- Data stores ---
# Two roles, same database. Row-level security applies to the application role and never to the owner.
#  - DATABASE_URL       application role (created by `npm run db:app-role`, which sets THIS password on it)
#  - DATABASE_ADMIN_URL owner role: `prisma migrate`, the audited superadmin bypass, tenant resolution
DATABASE_URL=postgresql://bmstore_app:change-me-app-role-password@localhost:5432/bmstore?schema=public
DATABASE_ADMIN_URL=postgresql://bmstore:bmstore@localhost:5432/bmstore?schema=public
REDIS_URL=redis://localhost:6379
TENANT_CACHE_TTL_SECONDS=300

# --- Auth (generate with: openssl rand -base64 48) ---
JWT_ACCESS_SECRET=change-me-change-me-change-me-change-me
JWT_ACCESS_TTL=15m
REFRESH_TTL_DAYS=30

# --- Login protection (defaults shown; Redis-backed per-IP limits fail OPEN if Redis is down, account locks live in Postgres) ---
LOGIN_IP_LIMIT=20
LOGIN_IP_WINDOW_SECONDS=60
LOGIN_MAX_FAILURES=5
LOGIN_LOCK_BASE_SECONDS=60
LOGIN_LOCK_MAX_SECONDS=3600
PASSWORD_RESET_TTL_MINUTES=30
# {host} = the Host the request came in on, {token} = the raw single-use token
PASSWORD_RESET_URL_TEMPLATE=https://{host}/reset-password?token={token}
FORGOT_PER_EMAIL_LIMIT=3
FORGOT_PER_IP_LIMIT=10
FORGOT_WINDOW_SECONDS=900

# --- Uploads: the browser PUTs files straight to S3 (or R2/MinIO) with a presigned URL from POST /store/uploads/presign.
# Leave S3_BUCKET empty to disable uploads (the endpoint answers 503). Never a multipart parser in the API.
# Local (docker compose up -d): MinIO. Production: Cloudflare R2 (S3_ENDPOINT=https://<account>.r2.cloudflarestorage.com,
# S3_FORCE_PATH_STYLE=0, S3_PUBLIC_BASE_URL=your public bucket domain) or AWS S3 (no S3_ENDPOINT).
S3_BUCKET=bmstore
S3_REGION=ap-south-1
S3_ENDPOINT=http://localhost:9000
S3_FORCE_PATH_STYLE=1
S3_ACCESS_KEY_ID=bmstore
S3_SECRET_ACCESS_KEY=bmstore-minio
# Where browsers load images from (defaults to <endpoint>/<bucket>, which is right for MinIO)
S3_PUBLIC_BASE_URL=
# per image, bytes (phone photos are 3-8 MB)
UPLOAD_MAX_BYTES=12582912
UPLOAD_URL_TTL_SECONDS=300
# WebP conversion runs inside the API process; set 0 to run it in a separate process (node dist/main.js with MEDIA_WORKER=1 there)
MEDIA_WORKER=1
MEDIA_WORKER_INTERVAL_MS=3000

# --- Encryption of Razorpay keys (AES-256-GCM). 32 random bytes, base64. ---
# generate with: openssl rand -base64 32
ENCRYPTION_KEY=

# --- Bootstrap superadmin (used by `npm run seed:superadmin`) ---
SUPERADMIN_EMAIL=
SUPERADMIN_PASSWORD=
