// BMStore – single database, multi-tenant. Every tenant-scoped row carries tenant_id.
// Isolation layers: (1) Prisma client extension auto-injects tenantId (src/prisma),
// (2) Postgres row-level security on every table (migration 0004), pinned per transaction via set_config,
// (3) composite (tenant_id, x) foreign keys make cross-tenant references impossible in the DB,
// (4) the gate test (test/gate.spec.ts) proves it for EVERY model, with and without the app layer.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL") // application role: no table ownership, NOBYPASSRLS -> row-level security applies
  directUrl = env("DATABASE_ADMIN_URL") // owner role: migrations and the audited superadmin bypass (exempt from RLS)
}

enum UserRole {
  superadmin
  store_owner
  staff
}

// Vocabulary is fixed (do not add synonyms): see PREWORK_REPORT.md.
enum TenantPlan {
  STARTER // at most 10 products (enforced by a DB trigger, migration 0006)
  STANDARD // unlimited within fair use
}

enum TenantStatus {
  BUILDING // being set up: store admins can log in and work, storefront not yet public
  LIVE
  SUSPENDED // blocked (e.g. non-payment): every request on the store host is refused
  PARKED // dormant: every request on the store host is refused
}

enum ProductStatus {
  DRAFT
  ACTIVE
  ARCHIVED
}

enum PaymentMode {
  COD
  ONLINE
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
  REFUNDED
  PARTIALLY_REFUNDED
}

enum OrderStatus {
  PENDING
  CONFIRMED
  PACKED
  SHIPPED
  DELIVERED
  CANCELLED
  RETURNED
}

enum CouponType {
  PERCENT
  FLAT
}

enum ShippingMode {
  FLAT
  FREE
  FREE_ABOVE
}

// MONEY: every amount is an integer number of paise (Int). No Float/Decimal columns anywhere; the gate test enforces it.

model Tenant {
  id                String       @id @default(uuid()) @db.Uuid
  name              String
  slug              String       @unique
  subdomain         String       @unique
  customDomain      String?      @unique @map("custom_domain")
  plan              TenantPlan   @default(STARTER)
  status            TenantStatus @default(BUILDING)
  gstNumber         String?      @map("gst_number")
  address           String?
  supportPhone      String?      @map("support_phone")
  razorpayKeyEnc    String?      @map("razorpay_key_enc")
  razorpaySecretEnc String?      @map("razorpay_secret_enc")
  whatsappNumber    String?      @map("whatsapp_number")
  createdAt         DateTime     @default(now()) @map("created_at")
  expiresAt         DateTime?    @map("expires_at")

  themeConfig   ThemeConfig?
  settings      Settings?
  products      Product[]
  variants      Variant[]
  categories    Category[]
  orders        Order[]
  customers     Customer[]
  coupons       Coupon[]
  pages         Page[]
  users         User[]
  refreshTokens RefreshToken[]

  @@index([status, expiresAt])
  @@map("tenants")
}

model ThemeConfig {
  tenantId         String   @id @map("tenant_id") @db.Uuid
  layoutVariant    String   @default("default") @map("layout_variant")
  paletteId        String   @default("classic") @map("palette_id")
  primaryColor     String   @default("#111827") @map("primary_color")
  secondaryColor   String   @default("#6B7280") @map("secondary_color")
  fontPairId       String   @default("modern") @map("font_pair_id")
  headerStyle      String   @default("standard") @map("header_style")
  cardStyle        String   @default("standard") @map("card_style")
  logoUrl          String?  @map("logo_url")
  bannerUrls       String[] @map("banner_urls")
  homepageSections Json     @default("[]") @map("homepage_sections")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@map("theme_configs")
}

model Category {
  id       String  @id @default(uuid()) @db.Uuid
  tenantId String  @map("tenant_id") @db.Uuid
  name     String
  slug     String
  parentId String? @map("parent_id") @db.Uuid
  image    String?

  tenant   Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  parent   Category?  @relation("CategoryTree", fields: [tenantId, parentId], references: [tenantId, id], onDelete: NoAction, onUpdate: NoAction)
  children Category[] @relation("CategoryTree")
  products Product[]

  @@unique([tenantId, id])
  @@unique([tenantId, slug])
  @@index([tenantId, parentId])
  @@map("categories")
}

model Product {
  id          String        @id @default(uuid()) @db.Uuid
  tenantId    String        @map("tenant_id") @db.Uuid
  name        String
  slug        String
  description String?
  price       Int // paise
  mrp         Int // paise
  sku         String?
  stock       Int           @default(0)
  status      ProductStatus @default(DRAFT)
  categoryId  String?       @map("category_id") @db.Uuid
  images      String[]
  hsnCode     String?       @map("hsn_code")
  createdAt   DateTime      @default(now()) @map("created_at")
  updatedAt   DateTime      @default(now()) @updatedAt @map("updated_at")

  tenant   Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  category Category? @relation(fields: [tenantId, categoryId], references: [tenantId, id], onDelete: NoAction, onUpdate: NoAction)
  variants Variant[]

  @@unique([tenantId, id])
  @@unique([tenantId, slug])
  @@unique([tenantId, sku])
  @@index([tenantId, status])
  @@index([tenantId, categoryId])
  @@map("products")
}

// Carries tenant_id like every other table; the composite FK (tenant_id, product_id) -> products(tenant_id, id)
// makes a variant of another tenant's product impossible at the database level.
model Variant {
  id          String  @id @default(uuid()) @db.Uuid
  tenantId    String  @map("tenant_id") @db.Uuid
  productId   String  @map("product_id") @db.Uuid
  optionName  String  @map("option_name")
  optionValue String  @map("option_value")
  priceDelta  Int     @default(0) @map("price_delta") // paise, may be negative
  stock       Int     @default(0)
  sku         String?

  tenant  Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [tenantId, productId], references: [tenantId, id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([tenantId, id])
  @@unique([tenantId, productId, optionName, optionValue])
  @@unique([tenantId, sku])
  @@index([tenantId, productId])
  @@map("variants")
}

model Customer {
  id        String  @id @default(uuid()) @db.Uuid
  tenantId  String  @map("tenant_id") @db.Uuid
  name      String
  phone     String
  email     String?
  addresses Json    @default("[]")

  tenant Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  orders Order[]

  @@unique([tenantId, id])
  @@unique([tenantId, phone])
  @@index([tenantId, email])
  @@map("customers")
}

model Order {
  id            String        @id @default(uuid()) @db.Uuid
  tenantId      String        @map("tenant_id") @db.Uuid
  orderNo       String        @map("order_no")
  customerId    String        @map("customer_id") @db.Uuid
  items         Json
  subtotal      Int // paise
  shipping      Int           @default(0) // paise
  tax           Int           @default(0) // paise
  total         Int // paise
  paymentMode   PaymentMode   @map("payment_mode")
  paymentStatus PaymentStatus @default(PENDING) @map("payment_status")
  orderStatus   OrderStatus   @default(PENDING) @map("order_status")
  address       Json
  createdAt     DateTime      @default(now()) @map("created_at")

  tenant   Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  customer Customer @relation(fields: [tenantId, customerId], references: [tenantId, id], onDelete: NoAction, onUpdate: NoAction)

  @@unique([tenantId, orderNo])
  @@index([tenantId, customerId])
  @@index([tenantId, orderStatus, createdAt])
  @@index([tenantId, createdAt])
  @@map("orders")
}

model Coupon {
  id         String     @id @default(uuid()) @db.Uuid
  tenantId   String     @map("tenant_id") @db.Uuid
  code       String
  type       CouponType
  value      Int // FLAT: paise off; PERCENT: whole percent (0-100)
  minOrder   Int        @default(0) @map("min_order") // paise
  usageLimit Int?       @map("usage_limit")
  expiresAt  DateTime?  @map("expires_at")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, code])
  @@map("coupons")
}

model Page {
  id       String  @id @default(uuid()) @db.Uuid
  tenantId String  @map("tenant_id") @db.Uuid
  slug     String
  title    String
  content  String
  isPolicy Boolean @default(false) @map("is_policy")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, slug])
  @@index([tenantId, isPolicy])
  @@map("pages")
}

model Settings {
  tenantId     String       @id @map("tenant_id") @db.Uuid
  shippingMode ShippingMode @default(FLAT) @map("shipping_mode")
  flatRate     Int          @default(0) @map("flat_rate") // paise
  freeAbove    Int?         @map("free_above") // paise
  codEnabled   Boolean      @default(true) @map("cod_enabled")
  codCharge    Int          @default(0) @map("cod_charge") // paise
  orderPrefix  String       @default("ORD") @map("order_prefix")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@map("settings")
}

// tenant_id is NULL only for superadmin (enforced by CHECK in migration 0002).
model User {
  id           String   @id @default(uuid()) @db.Uuid
  tenantId     String?  @map("tenant_id") @db.Uuid
  email        String
  phone        String?
  passwordHash String   @map("password_hash")
  role         UserRole
  isActive     Boolean  @default(true) @map("is_active")
  createdAt    DateTime @default(now()) @map("created_at")

  tenant                Tenant?        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  refreshTokens         RefreshToken[] @relation("RefreshTokenUser")
  refreshTokensInTenant RefreshToken[] @relation("RefreshTokenUserTenant")

  @@unique([tenantId, id])
  @@unique([tenantId, email])
  @@index([tenantId, role])
  @@map("users")
}

// Not in the spec's table list: needed for refresh-token rotation/revocation. See PHASE1_REPORT.md.
model RefreshToken {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  tenantId  String?   @map("tenant_id") @db.Uuid
  familyId  String    @map("family_id") @db.Uuid
  tokenHash String    @unique @map("token_hash")
  expiresAt DateTime  @map("expires_at")
  revokedAt DateTime? @map("revoked_at")
  createdAt DateTime  @default(now()) @map("created_at")

  user         User    @relation("RefreshTokenUser", fields: [userId], references: [id], onDelete: Cascade)
  // Composite FK: a token's tenant must be its user's tenant (not enforced when tenant_id is NULL = superadmin).
  userInTenant User?   @relation("RefreshTokenUserTenant", fields: [tenantId, userId], references: [tenantId, id], onDelete: Cascade, onUpdate: NoAction)
  tenant       Tenant? @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, userId])
  @@index([familyId])
  @@map("refresh_tokens")
}

// Append-only (DB trigger in migration 0002). No FKs: logs outlive tenants/users.
model AuditLog {
  id        String   @id @default(uuid()) @db.Uuid
  actorId   String?  @map("actor_id") @db.Uuid
  action    String
  tenantId  String?  @map("tenant_id") @db.Uuid
  meta      Json     @default("{}")
  createdAt DateTime @default(now()) @map("created_at")

  @@index([tenantId, createdAt])
  @@index([actorId, createdAt])
  @@map("audit_logs")
}
