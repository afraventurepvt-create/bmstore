# =============================================================================
# BMStore production environment  —  copy to /etc/bmstore/production.env
#
#   sudo install -d -m 750 -o root -g deploy /etc/bmstore
#   sudo install -m 640 -o root -g deploy deploy/.env.production.example /etc/bmstore/production.env
#   sudo nano /etc/bmstore/production.env
#
# This ONE file feeds: docker compose (deploy/compose.sh), the deploy script,
# the backup/restore scripts and the monitoring cron jobs.
# Rules: KEY=value, no spaces around "=", quote values that contain spaces or
# the characters # $ ! with single quotes. Never commit this file.
# Generate secrets with:  openssl rand -base64 48     (or -hex 32)
# =============================================================================

# ---------------------------------------------------------------------------
# 1. Domains / TLS
# ---------------------------------------------------------------------------
# Platform root. Tenants live at <slug>.store.bmtechx.in ; platform hosts are
# api.<ROOT_DOMAIN>, admin.<ROOT_DOMAIN>, console.<ROOT_DOMAIN>
ROOT_DOMAIN=store.bmtechx.in
# Let's Encrypt account e-mail (expiry notices go here)
ACME_EMAIL=ops@bmtechx.in
# Which Caddyfile to mount from infra/caddy/ :
#   Caddyfile          -> on-demand TLS for every tenant host (default, works with any DNS provider)
#   Caddyfile.wildcard -> *.store.bmtechx.in wildcard via DNS-01 (needs CADDY_DNS_PLUGIN + provider token)
CADDYFILE=Caddyfile
# Only for Caddyfile.wildcard: a caddy-dns module name (cloudflare, digitalocean, hetzner, godaddy, namecheap ...)
# and the token the module expects. Rebuild caddy after changing:  ./deploy/compose.sh build caddy
CADDY_DNS_PLUGIN=
DNS_API_TOKEN=

# ---------------------------------------------------------------------------
# 2. Image tags (managed by deploy/deploy.sh – normally leave alone)
# ---------------------------------------------------------------------------
# IMAGE_TAG=

# ---------------------------------------------------------------------------
# 3. Postgres 16
# ---------------------------------------------------------------------------
# Owner role: owns the schema, runs migrations, used by backups. NOT used by the app.
POSTGRES_USER=bmstore
POSTGRES_PASSWORD=CHANGE_ME_owner_password
POSTGRES_DB=bmstore
# Application role (non-owner, DML only). Created/kept in sync by infra/postgres/app-role.sql
APP_DB_USER=bmstore_app
APP_DB_PASSWORD=CHANGE_ME_app_password

# ---------------------------------------------------------------------------
# 4. Redis 7
# ---------------------------------------------------------------------------
REDIS_PASSWORD=CHANGE_ME_redis_password

# ---------------------------------------------------------------------------
# 5. API secrets (apps/api/src/config/app-config.ts)
# ---------------------------------------------------------------------------
# >= 32 chars:  openssl rand -base64 48
JWT_ACCESS_SECRET=CHANGE_ME_at_least_32_characters_long_secret
JWT_ACCESS_TTL=15m
REFRESH_TTL_DAYS=30
# Exactly 32 random bytes, base64:  openssl rand -base64 32
# Losing this key makes every stored Razorpay secret unreadable. Back it up offline (see SERVER_HARDENING.md).
ENCRYPTION_KEY=CHANGE_ME_base64_32_bytes
TENANT_CACHE_TTL_SECONDS=300
# Caddy terminates TLS and sets X-Forwarded-*; the API must trust it.
TRUST_PROXY=1

# ---------------------------------------------------------------------------
# 6. Media / object storage  (the API does not upload yet; wired for Phase 2)
# ---------------------------------------------------------------------------
# MEDIA_BACKEND=minio  -> run the bundled MinIO (compose profile "minio"), data on this VPS
# MEDIA_BACKEND=s3     -> external bucket (Cloudflare R2, AWS S3, DigitalOcean Spaces, Hetzner Object Storage)
MEDIA_BACKEND=minio
# Used by the app in Phase 2 and by the backup job (weekly media copy)
S3_ENDPOINT=http://minio:9000
S3_REGION=auto
S3_BUCKET=bmstore-media
S3_ACCESS_KEY=CHANGE_ME_media_access_key
S3_SECRET_KEY=CHANGE_ME_media_secret_key
# Public base URL browsers use to load media (MinIO is published by Caddy at media.<ROOT_DOMAIN>)
S3_PUBLIC_URL=https://media.store.bmtechx.in/bmstore-media
# MinIO only: root credentials (also used as S3_ACCESS_KEY/S3_SECRET_KEY unless you create a scoped user)
MINIO_ROOT_USER=CHANGE_ME_media_access_key
MINIO_ROOT_PASSWORD=CHANGE_ME_media_secret_key

# ---------------------------------------------------------------------------
# 7. Backups  (infra/backup/*.sh)  — a SEPARATE bucket, ideally a separate provider/account
# ---------------------------------------------------------------------------
# rclone S3-compatible remote. Provider: Cloudflare | AWS | DigitalOcean | Hetzner | Minio | Other
BACKUP_S3_PROVIDER=Cloudflare
BACKUP_S3_ENDPOINT=https://ACCOUNT_ID.r2.cloudflarestorage.com
BACKUP_S3_REGION=auto
BACKUP_S3_BUCKET=bmstore-backups
BACKUP_S3_ACCESS_KEY=CHANGE_ME_backup_access_key
BACKUP_S3_SECRET_KEY=CHANGE_ME_backup_secret_key
# Days to keep nightly/weekly/pre-deploy dumps in the bucket
BACKUP_RETENTION_DAYS=30
# Encrypt dumps client-side with age (public key). Leave empty to skip. Keep the private key OFF the server.
BACKUP_AGE_RECIPIENT=
# Also copy media (MinIO bucket or S3 bucket) into the backup bucket during the weekly job: 1/0
BACKUP_INCLUDE_MEDIA=1

# ---------------------------------------------------------------------------
# 8. Monitoring / alerts  (infra/monitoring/*.sh)
# ---------------------------------------------------------------------------
# Where alerts go:  stdout | webhook | whatsapp-cloud   (comma-separate for several, e.g. stdout,whatsapp-cloud)
NOTIFY_CHANNELS=stdout
# Generic webhook: POST {"severity","title","message","host","time"} as JSON (Slack/Discord/n8n/Make/your own)
NOTIFY_WEBHOOK_URL=
# WhatsApp via Meta Cloud API (stub – see infra/monitoring/notify.sh and docs/runbooks/MONITORING.md)
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
# Owner's number in international format without "+", e.g. 919876543210
WHATSAPP_OWNER_NUMBER=
# Re-send an alert that is still firing after this many minutes (0 = only on change)
ALERT_REPEAT_MINUTES=240
# Disk / media thresholds (percent of root filesystem, GB for media)
DISK_WARN_PERCENT=80
DISK_CRIT_PERCENT=90
MEDIA_WARN_GB=50
# Warn when any certificate expires in fewer than this many days
SSL_WARN_DAYS=14
# Extra hosts to uptime-check besides tenants (space separated)
UPTIME_EXTRA_HOSTS=

# ---------------------------------------------------------------------------
# 9. Deploy
# ---------------------------------------------------------------------------
# Branch deployed by deploy/deploy.sh when no ref is given
DEPLOY_BRANCH=main
# Compose profiles to enable: "minio" for bundled object storage, "web" once storefront/admin/console exist
COMPOSE_PROFILES=minio
# Upstreams Caddy proxies to. Until the frontends exist, point them at the API so hosts answer.
STOREFRONT_UPSTREAM=api:3000
ADMIN_UPSTREAM=api:3000
CONSOLE_UPSTREAM=api:3000
